        "runId": { "type": "string", "description": "Run identifier." },
        "afterSequence": { "type": "integer", "minimum": 0, "description": "Return events strictly after this sequence." }
      },
      "required": ["runId"],
      "additionalProperties": false
    },
    "InspectOutput": {

        "state": { "$ref": "#/$defs/RunState", "description": "Initial state after acceptance." }
      },
      "required": ["runId", "state"],
      "additionalProperties": false
    },
    "InspectInput": {
      "type": "object",
      "description": "Read one run and its append-only events.",

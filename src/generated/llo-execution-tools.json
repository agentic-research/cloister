        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/CapabilityDescriptor" }, "description": "Supported interfaces and backend classes." }
      },
      "required": ["capabilities"],
      "additionalProperties": false
    },
    "StatusInput": {
      "type": "object",
      "description": "Read substrate readiness without provisioning or creating storage.",
      "properties": {
        "runId": { "type": "string", "description": "Optional run to inspect; empty means substrate status." }
      },
      "required": [],
      "additionalProperties": false
    },
    "StatusOutput": {
      "type": "object",
      "description": "Read-only substrate or run status.",
      "properties": {
        "provisioned": { "type": "boolean", "description": "Whether the selected backend is explicitly provisioned." },

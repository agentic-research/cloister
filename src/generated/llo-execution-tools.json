        "backendClass": { "$ref": "#/$defs/BackendClass", "description": "Isolation class to provision." },
        "idempotencyKey": { "type": "string", "description": "Caller-stable retry key." }
      },
      "required": ["backendClass", "idempotencyKey"],
      "additionalProperties": false
    },
    "ProvisionOutput": {
      "type": "object",
      "description": "Provisioning result.",
      "properties": {
        "provisioned": { "type": "boolean", "description": "True when the backend is ready." },
        "backendId": { "type": "string", "description": "Selected backend implementation identifier." }
      },
      "required": ["provisioned", "backendId"],
      "additionalProperties": false
    },

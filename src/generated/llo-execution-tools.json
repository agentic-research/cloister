        "spec": { "$ref": "#/$defs/RunSpec", "description": "Untrusted execution intent." },
        "grant": { "$ref": "#/$defs/RunGrant", "description": "Authenticated resolved authority bound to spec." }
      },
      "required": ["spec", "grant"],
      "additionalProperties": false
    },
    "StartOutput": {
      "type": "object",

        "runId": { "type": "string", "description": "Run identifier; empty for substrate status." },
        "state": { "$ref": "#/$defs/RunState", "description": "Current state; accepted is the neutral value for substrate-only status." },
        "lastEvent": { "type": "integer", "minimum": 0, "description": "Latest observed event sequence; zero when no run was selected." }
      },
      "required": ["provisioned", "backend", "runId", "state", "lastEvent"],
      "additionalProperties": false
    },
    "ProvisionInput": {
      "type": "object",
      "description": "Explicitly and idempotently provision execution storage or backend resources.",

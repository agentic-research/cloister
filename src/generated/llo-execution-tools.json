      },
      "required": ["runId", "state", "events"],
      "additionalProperties": false
    },
    "CancelInput": {
      "type": "object",
      "description": "Request cancellation using the run capability.",
      "properties": {
        "runId": { "type": "string", "description": "Run identifier." },
        "idempotencyKey": { "type": "string", "description": "Caller-stable retry key." }
      },
      "required": ["runId", "idempotencyKey"],
      "additionalProperties": false
    },
    "CancelOutput": {
      "type": "object",
      "description": "Cancellation request result.",
      "properties": {
        "runId": { "type": "string", "description": "Run identifier." },
        "state": { "$ref": "#/$defs/RunState", "description": "Observed state after the request." }
      },
      "required": ["runId", "state"],
      "additionalProperties": false
    },
    "CollectInput": {
      "type": "object",
      "description": "Collect declared outputs and a terminal receipt.",
      "properties": {
        "runId": { "type": "string", "description": "Terminal run identifier." }
      },
      "required": ["runId"],
      "additionalProperties": false
    },
    "CollectOutput": {
      "type": "object",
      "description": "Declared outputs and terminal receipt.",
      "properties": {
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/ArtifactResult" }, "description": "Declared collected outputs." },
        "receipt": { "$ref": "#/$defs/RunReceipt", "description": "Terminal substrate receipt." }
      },
      "required": ["outputs", "receipt"],
      "additionalProperties": false
    },
    "CleanupInput": {
      "type": "object",
      "description": "Idempotently release one run's ephemeral resources.",
      "properties": {
        "runId": { "type": "string", "description": "Run identifier." },
        "idempotencyKey": { "type": "string", "description": "Caller-stable retry key." }
      },
      "required": ["runId", "idempotencyKey"],
      "additionalProperties": false
    },
    "CleanupOutput": {
      "type": "object",
      "description": "Cleanup result.",
      "properties": {
        "runId": { "type": "string", "description": "Run identifier." },
        "state": { "$ref": "#/$defs/RunState", "description": "cleaned when all ephemeral resources are released." }
      },
      "required": ["runId", "state"],
      "additionalProperties": false
    }
      },
      "required": ["spec", "grant"]
    }

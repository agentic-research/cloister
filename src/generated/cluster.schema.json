        "entryPoint": { "type": "string" },
        "apiKeyEnv": { "type": "string" },
        "baseUrlEnv": { "type": "string" },
        "stripEnv": { "type": "array", "items": { "type": "string" } },
        "stateDirEnv": { "type": "string" },
        "stateDir": { "type": "string" },
        "authModes": { "type": "array", "items": { "type": "string" } },
        "provenance": { "type": "string" },
        "executable": { "type": "string" },
        "subscriptionTokenEnv": { "type": "string" }
      },
      "required": ["name", "service", "entryPoint", "apiKeyEnv", "baseUrlEnv", "stripEnv", "stateDirEnv", "stateDir", "authModes", "provenance", "executable", "subscriptionTokenEnv"],
      "additionalProperties": false
    },
    "SkillDeclaration": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "digest": { "type": "string" }
      },
      "required": ["name", "digest"],
      "additionalProperties": false
    },
    "HeaderNamedSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "QueryParamSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"],

    },
    "BodyFieldSpec": {
      "type": "object",
      "properties": {
        "path": { "type": "string" }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "ConnectionTarget": {
      "type": "object",
      "description": "The bundle port that answers a connection in one environment.",
      "properties": {
        "env": { "type": "string", "description": "The environment, for example 'local'. Unique within a connection." },
        "bundle": { "type": "string", "description": "The target bundle. Never the connection's own from bundle." },
        "port": { "type": "string", "description": "The name of a port on the target bundle whose expose is not 'none'." }
      },
      "required": ["env", "bundle", "port"],
      "additionalProperties": false
    },
    "GeneratedBackend": {
      "type": "object",
      "properties": {

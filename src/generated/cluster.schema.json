{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by schema-bridge — do not edit by hand.",
  "$id": "cluster.schema.json",
  "$defs": {
    "Tier": { "type": "string", "enum": ["hypervisor", "cluster"] },
    "ClusterMetadata": {
      "type": "object",
      "description": "Names the cluster.",
      "properties": {
        "name": { "type": "string", "description": "The cluster's name. Required. Appears in container labels." },
        "version": { "type": "string", "description": "The cluster's version, pinned at deploy time. Required." }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "Bundle": {
      "type": "object",
      "description": "One unit of deployment in the cluster.",
      "properties": {
        "name": { "type": "string", "description": "The bundle's name. Unique in the cluster. A bundle that a connection touches must be named as a DNS label." },
        "description": { "type": "string", "description": "One line describing the bundle. Appears in container labels." },
        "tier": { "$ref": "#/$defs/Tier", "description": "'hypervisor' for a bundle that mediates between other bundles or to the outside, 'cluster' for a tool bundle. Documentation and audit, not a runtime gate." },
        "holdsCredential": { "type": "array", "items": { "type": "string" }, "description": "The credential bindings this bundle may hold, by binding name. Empty means it holds none. A cluster-tier bundle must leave it empty." },
        "workerdServiceName": { "type": "string", "description": "The workerd service this bundle corresponds to, when its name there differs. Empty for a bundle that does not run inside the router's workerd." },
        "hypervisorRationale": { "type": "string", "description": "Why this bundle is hypervisor tier. Required when tier is 'hypervisor'." },
        "perTenant": { "type": "boolean", "description": "When true, one instance of the bundle is produced per tenant. Requires a tenantDispatch route." },
        "confinement": { "$ref": "#/$defs/Confinement", "description": "What the bundle may touch: filesystem paths, egress hosts, one listener port, a credential source. Anything not allowed is denied." },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/PortSpec" }, "description": "The bundle's named inbound ports. A connection refers to a port by name." },
        "placements": { "type": "array", "items": { "$ref": "#/$defs/PlacementSpec" }, "description": "Where the bundle runs, one row per environment." },
        "kind": {
          "oneOf": [
            { "type": "object", "properties": { "workerd": { "$ref": "#/$defs/WorkerdBundle" } }, "required": ["workerd"], "additionalProperties": false },
            { "type": "object", "properties": { "external": { "$ref": "#/$defs/ExternalBundle" } }, "required": ["external"], "additionalProperties": false }
          ]
        }
      },
      "required": ["name", "description", "tier", "holdsCredential", "workerdServiceName", "hypervisorRationale", "perTenant", "confinement", "ports", "placements", "kind"],
      "additionalProperties": false
    },
    "Wire": {
      "type": "object",
      "description": "A service binding from one bundle to another.",
      "properties": {
        "from": { "type": "string", "description": "The source bundle." },
        "to": { "type": "string", "description": "The target bundle." },
        "binding": { "type": "string", "description": "The binding name the source uses to reach the target." },
        "transport": {
          "oneOf": [
            { "type": "object", "properties": { "uds": { "type": "null" } }, "required": ["uds"], "additionalProperties": false },
            { "type": "object", "properties": { "leylineNet": { "type": "null" } }, "required": ["leylineNet"], "additionalProperties": false }
          ]
        }
      },
      "required": ["from", "to", "binding", "transport"],
      "additionalProperties": false
    },
    "StoragePolicy": {
      "type": "object",
      "description": "Where durable state is mounted.",
      "properties": {
        "doStoragePath": { "type": "string", "description": "The path where Durable Object storage is mounted. Must match the image and the workerd config. Usually '/data/do'." }
      },
      "required": ["doStoragePath"],
      "additionalProperties": false
    },
    "InputSpec": {
      "type": "object",
      "description": "An external tool, skill or bundle the cluster composes.",
      "properties": {
        "name": { "type": "string", "description": "The input's name. Unique in the cluster. In cluster.toml it is the key of the [inputs.<name>] table." },
        "ref": { "type": "string", "description": "Where the input comes from: a registry name, an https URL, or a file URL." },
        "version": { "type": "string", "description": "The version, or a semver range. Empty picks the latest, which is not recommended." },
        "digest": { "type": "string", "description": "The expected digest, as 'sha256:<hex>'. The fetched bytes must match it. Empty means the resolver pins one in cluster.lock.toml." },
        "from": { "type": "string", "description": "A local checkout to use while developing, as a file URL. It overrides ref, so it must not be committed." },
        "provides": { "type": "array", "items": { "type": "string" }, "description": "Capabilities this input offers, for example 'cloister/mcp-tool/v1'." },
        "requires": { "type": "array", "items": { "type": "string" }, "description": "Capabilities this input needs another input to provide." },
        "urlBinding": { "type": "string", "description": "The binding that holds the input's upstream URL." },
        "serviceBinding": { "type": "string", "description": "The workerd service binding that reaches the input, used in preference to urlBinding when set." },
        "tenancy": { "$ref": "#/$defs/TenancySpec" },
        "requiresSessionRetired": { "type": "boolean" },
        "connection": { "$ref": "#/$defs/Connection" },
        "mutableTagReason": { "type": "string" }
      },
      "required": ["name", "ref", "version", "digest", "from", "provides", "requires", "urlBinding", "serviceBinding", "tenancy", "requiresSessionRetired", "connection", "mutableTagReason"],
      "additionalProperties": false
    },
    "Route": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "kind": {
          "oneOf": [
            { "type": "object", "properties": { "health": { "type": "null" } }, "required": ["health"], "additionalProperties": false },
            { "type": "object", "properties": { "mcp": { "$ref": "#/$defs/McpRouteSpec" } }, "required": ["mcp"], "additionalProperties": false },
            { "type": "object", "properties": { "serviceBindingProxy": { "$ref": "#/$defs/ServiceBindingProxySpec" } }, "required": ["serviceBindingProxy"], "additionalProperties": false },
            { "type": "object", "properties": { "httpProxy": { "$ref": "#/$defs/HttpProxySpec" } }, "required": ["httpProxy"], "additionalProperties": false },
            { "type": "object", "properties": { "wellKnownInterlace": { "type": "null" } }, "required": ["wellKnownInterlace"], "additionalProperties": false },
            { "type": "object", "properties": { "disclosure": { "type": "null" } }, "required": ["disclosure"], "additionalProperties": false },
            { "type": "object", "properties": { "wellKnownIdentityBridge": { "type": "null" } }, "required": ["wellKnownIdentityBridge"], "additionalProperties": false },
            { "type": "object", "properties": { "ociRegistry": { "type": "null" } }, "required": ["ociRegistry"], "additionalProperties": false },
            { "type": "object", "properties": { "wellKnownMcpRegistry": { "type": "null" } }, "required": ["wellKnownMcpRegistry"], "additionalProperties": false },
            { "type": "object", "properties": { "caBundle": { "type": "null" } }, "required": ["caBundle"], "additionalProperties": false },
            { "type": "object", "properties": { "vaultProxy": { "$ref": "#/$defs/VaultProxySpec" } }, "required": ["vaultProxy"], "additionalProperties": false },
            { "type": "object", "properties": { "tenantDispatch": { "$ref": "#/$defs/TenantDispatchSpec" } }, "required": ["tenantDispatch"], "additionalProperties": false }
          ]
        }
      },
      "required": ["path", "kind"],
      "additionalProperties": false
    },
    "Gateway": {
      "type": "object",
      "properties": {
        "metadata": { "$ref": "#/$defs/GatewayMetadata" },
        "actor": { "$ref": "#/$defs/Actor" },
        "policy": { "$ref": "#/$defs/InterlacePolicy" },
        "vaultProxyServices": { "type": "array", "items": { "$ref": "#/$defs/VaultProxyService" } },
        "harnessTargets": { "type": "array", "items": { "$ref": "#/$defs/HarnessTarget" } },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/SkillDeclaration" } }
      },
      "required": ["metadata", "actor", "policy", "vaultProxyServices", "harnessTargets", "skills"],
      "additionalProperties": false
    },
    "EdgeSpec": {
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "appProtocol": { "type": "string" },
        "transport": { "type": "string" }
      },
      "required": ["from", "to", "appProtocol", "transport"],
      "additionalProperties": false
    },
    "ConnectionSpec": {
      "type": "object",
      "description": "One declared outbound connection from a bundle to another bundle's port.",
      "properties": {
        "from": { "type": "string", "description": "The bundle that dials." },
        "name": { "type": "string", "description": "The connection's name. Unique per from bundle." },
        "appProtocol": { "type": "string", "description": "What is spoken. Must equal the target port's appProtocol." },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/ConnectionTarget" }, "description": "Which bundle port answers, one row per environment." },
        "minStrength": { "type": "string", "description": "The weakest enforcement this edge may have: 'none', 'policy' or 'capability'. The build fails if the two ends' placements deliver less. Empty means no floor." }
      },
      "required": ["from", "name", "appProtocol", "targets", "minStrength"],
      "additionalProperties": false
    },
    "Cluster": {
      "type": "object",
      "description": "A cloister cluster: its bundles, how they connect, and the gateway in front of them.",
      "properties": {
        "metadata": { "$ref": "#/$defs/ClusterMetadata", "description": "The cluster's name and version." },
        "bundles": { "type": "array", "items": { "$ref": "#/$defs/Bundle" }, "description": "The processes that make up the cluster." },
        "wires": { "type": "array", "items": { "$ref": "#/$defs/Wire" }, "description": "Service bindings between bundles: one bundle reaches another through a named binding." },
        "storage": { "$ref": "#/$defs/StoragePolicy", "description": "Where durable state is mounted." },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/InputSpec" }, "description": "External tools, skills and bundles the cluster composes, each pinned by reference and version." },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/Route" }, "description": "The HTTP routes the gateway serves." },
        "gateway": { "$ref": "#/$defs/Gateway", "description": "The gateway's own identity and policy, and its vault proxy services, harness targets and skills." },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/EdgeSpec" }, "description": "Cross-tenant edges: which tenant may reach which, and for what protocol." },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/ConnectionSpec" }, "description": "Declared outbound connections: which bundle dials which bundle's port, per environment." }
      },
      "required": ["metadata", "bundles", "wires", "storage", "inputs", "routes", "gateway", "edges", "connections"],
      "additionalProperties": false
    },
    "WorkerdBundle": {
      "type": "object",
      "description": "A bundle that runs as a v8 isolate inside the router's workerd.",
      "properties": {
        "entryPoint": { "type": "string", "description": "Path to the bundle's entry point, relative to the cloister source tree." }
      },
      "required": ["entryPoint"],
      "additionalProperties": false
    },
    "ExternalBundle": {
      "type": "object",
      "description": "A bundle that runs its own image, outside the router's workerd.",
      "properties": {
        "image": { "type": "string", "description": "The OCI image reference." },
        "ipcSocket": { "type": "string", "description": "The unix socket path the bundle listens on for tool calls." },
        "httpPort": { "type": "integer", "minimum": 0, "description": "A TCP port the bundle also serves HTTP on. 0 means none." },
        "args": { "type": "array", "items": { "type": "string" }, "description": "Command-line arguments, passed to the entry point exactly as written." },
        "env": { "type": "array", "items": { "$ref": "#/$defs/EnvVar" }, "description": "Environment variables to set for the bundle. Stored in clear, so not for secrets." },
        "entryPoint": { "type": "string", "description": "Absolute path of the binary inside the image. Required for a microvm bundle." },
        "executionMode": { "type": "string", "description": "'microvm' to run isolated, or 'process' to run without isolation. 'process' needs executionModeRationale." },
        "executionModeRationale": { "type": "string", "description": "Why this bundle cannot be isolated. Required when executionMode is 'process'." },
        "runs": { "type": "string", "description": "'service' to run until stopped, or 'job' to run to completion. Empty means 'service'." },
        "workspace": { "type": "string", "description": "The operator's workspace, given to the bundle at /work: 'read' or 'write'. Empty means none." }
      },
      "required": ["image", "ipcSocket", "httpPort", "args", "env", "entryPoint", "executionMode", "executionModeRationale", "runs", "workspace"],
      "additionalProperties": false
    },
    "Confinement": {
      "type": "object",
      "description": "What a bundle may touch. Every dimension denies by default.",
      "properties": {
        "fs": { "$ref": "#/$defs/ConfinementFs", "description": "Filesystem access." },
        "network": { "$ref": "#/$defs/ConfinementNetwork", "description": "Outbound network access." },
        "port": { "$ref": "#/$defs/ConfinementPort", "description": "The one port the bundle may listen on." },
        "credentialSource": { "type": "string", "description": "The vault backend the bundle's credentials come from, for example 'keychain://...'. Empty means none." }
      },
      "required": ["fs", "network", "port", "credentialSource"],
      "additionalProperties": false
    },
    "PortSpec": {
      "type": "object",
      "description": "One named inbound port.",
      "properties": {
        "name": { "type": "string", "description": "The port's name. Unique per bundle. Connections refer to it." },
        "port": { "type": "integer", "minimum": 0, "description": "The port number. Unique per bundle, and not zero." },
        "appProtocol": { "type": "string", "description": "What is spoken on the port: a blessed 'art.*' label such as 'art.http' or 'art.grpc', or a vendor 'x-' label. A connection to this port must declare the same label." },
        "expose": { "type": "string", "description": "Who may reach the port. 'none': nobody, and it cannot be a connection target. 'cluster': only through declared connections. 'edge': also from outside. Empty means 'none'." }
      },
      "required": ["name", "port", "appProtocol", "expose"],
      "additionalProperties": false
    },
    "PlacementSpec": {
      "type": "object",
      "description": "Where a bundle runs in one environment.",
      "properties": {
        "env": { "type": "string", "description": "The environment this row applies to, for example 'local'. Unique per bundle." },
        "kind": { "type": "string", "description": "How it runs. 'microvm', 'workerd' or 'compose': cloister builds and starts it. 'kubernetes', 'knative' or 'cloudRun': cloister checks and wires a manifest it does not own." },
        "manifest": { "type": "string", "description": "Path, relative to the cluster directory, to the rendered manifest, for 'kubernetes' and 'knative'. Omit it when a plan describes the placement. Not allowed for 'microvm' or 'workerd'." },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/PlacementPort" }, "description": "Ports that are dialled on a different number in this placement than the workload listens on. Forwarded kinds only." },
        "name": { "type": "string", "description": "What this bundle is called in this environment's plan or manifest, when that is not the bundle's name. 'inspect --env' matches by it. Forwarded kinds only." },
        "sharesNetworkOf": { "type": "string", "description": "The bundle whose network namespace this one's container joins, so that the two share 127.0.0.1. 'compose' only. Leave empty for a container with a network of its own." }
      },
      "required": ["env", "kind", "manifest", "ports", "name", "sharesNetworkOf"],
      "additionalProperties": false
    },
    "ConfinementFs": {
      "type": "object",
      "description": "Filesystem paths the bundle may use.",
      "properties": {
        "allow": { "type": "array", "items": { "$ref": "#/$defs/FsAllowEntry" }, "description": "Path prefixes the bundle may use. In cluster.toml an entry is a bare path (read-only) or a table with path and mode. Empty denies all filesystem access." }
      },
      "required": ["allow"],
      "additionalProperties": false
    },
    "ConfinementNetwork": {
      "type": "object",
      "description": "Hosts the bundle may connect to.",
      "properties": {
        "allowHosts": { "type": "array", "items": { "type": "string" }, "description": "Hostnames the bundle may reach. A leading '*.' matches subdomains. Empty denies all egress." }
      },
      "required": ["allowHosts"],
      "additionalProperties": false
    },
    "ConfinementPort": {
      "type": "object",
      "description": "The listener the bundle may bind.",
      "properties": {
        "bind": { "type": "integer", "minimum": 0, "description": "The port, 1024 to 65535. 0 means no listener." },
        "address": { "type": "string", "description": "The address to bind. Empty means 127.0.0.1." }
      },
      "required": ["bind", "address"],
      "additionalProperties": false
    },
    "FsAllowEntry": {
      "type": "object",
      "description": "One allowed path.",
      "properties": {
        "path": { "type": "string", "description": "The path prefix." },
        "mode": { "type": "string", "description": "Empty for read-only, 'rw' for read and write." }
      },
      "required": ["path", "mode"],
      "additionalProperties": false
    },
    "PlacementPort": {
      "type": "object",
      "description": "What is different about one port in one placement: the number it is dialled on, whether it can be reached from outside, or both.",
      "properties": {
        "name": { "type": "string", "description": "The name of one of the bundle's ports." },
        "port": { "type": "integer", "minimum": 0, "description": "The number a peer dials in this placement. The workload still listens on the bundle port's own number. 0 means the same number." },
        "expose": { "type": "string", "description": "'cluster' or 'edge' for this placement only. Empty means as the bundle's port says." }
      },
      "required": ["name", "port", "expose"],
      "additionalProperties": false
    },
    "EnvVar": {
      "type": "object",
      "description": "One environment variable. Its value is a literal, the address of a connection, or a secret reference. A secret may also name the connection whose address it holds.",
      "properties": {
        "name": { "type": "string", "description": "The variable's name. Not empty, and without '=' or NUL." },
        "value": { "type": "string", "description": "A literal value. Stored in clear. Leave empty when connection or secret is set." },
        "connection": { "type": "string", "description": "The name of one of this bundle's connections. Alone: the variable is set to that connection's address in the placement being lowered. With secret: the secret holds that address, and nothing is written." },
        "path": { "type": "string", "description": "Text appended to the connection's address, for example '/api'. Only with connection." },
        "secret": { "type": "string", "description": "The name of a secret the value is read from. The value itself is never stored here." },
        "secretKey": { "type": "string", "description": "The key or version inside the secret. Only with secret." }
      },
      "required": ["name", "value", "connection", "path", "secret", "secretKey"],
      "additionalProperties": false
    },
    "TenancySpec": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "workerdId": { "type": "string" },
        "trustedTier": { "type": "boolean" },
        "sharesWorkerdWith": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["mode", "workerdId", "trustedTier", "sharesWorkerdWith"],
      "additionalProperties": false
    },
    "Connection": {
      "type": "object",
      "properties": {
        "socketPath": { "type": "string" },
        "vaultSlice": { "type": "string" },
        "transport": {
          "oneOf": [
            { "type": "object", "properties": { "unset": { "type": "null" } }, "required": ["unset"], "additionalProperties": false },
            { "type": "object", "properties": { "uds": { "type": "null" } }, "required": ["uds"], "additionalProperties": false }
          ]
        }
      },
      "required": ["socketPath", "vaultSlice", "transport"],
      "additionalProperties": false
    },
    "McpRouteSpec": {
      "type": "object",
      "properties": {
        "backends": { "type": "array", "items": { "$ref": "#/$defs/Backend" } }
      },
      "required": ["backends"],
      "additionalProperties": false
    },
    "ServiceBindingProxySpec": {
      "type": "object",
      "properties": {
        "binding": { "type": "string" },
        "upstreamHost": { "type": "string" },
        "stripPrefix": { "type": "string" }
      },
      "required": ["binding", "upstreamHost", "stripPrefix"],
      "additionalProperties": false
    },
    "HttpProxySpec": {
      "type": "object",
      "properties": {
        "urlBinding": { "type": "string" },
        "stripPrefix": { "type": "string" }
      },
      "required": ["urlBinding", "stripPrefix"],
      "additionalProperties": false
    },
    "VaultProxySpec": {
      "type": "object",
      "properties": {
        "bundleIdName": { "type": "string" }
      },
      "required": ["bundleIdName"],
      "additionalProperties": false
    },
    "TenantDispatchSpec": {
      "type": "object",
      "properties": {
        "tenants": { "type": "array", "items": { "$ref": "#/$defs/TenantDispatchRow" } }
      },
      "required": ["tenants"],
      "additionalProperties": false
    },
    "Backend": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "handlesPrefix": { "type": "string" },
        "kind": {
          "oneOf": [
            { "type": "object", "properties": { "durableObject": { "$ref": "#/$defs/DoBackend" } }, "required": ["durableObject"], "additionalProperties": false },
            { "type": "object", "properties": { "serviceBinding": { "$ref": "#/$defs/ServiceBindingBackend" } }, "required": ["serviceBinding"], "additionalProperties": false },
            { "type": "object", "properties": { "udsForward": { "$ref": "#/$defs/UdsForwardBackend" } }, "required": ["udsForward"], "additionalProperties": false },
            { "type": "object", "properties": { "leylineNet": { "$ref": "#/$defs/LeylineNetBackend" } }, "required": ["leylineNet"], "additionalProperties": false },
            { "type": "object", "properties": { "mcpProxy": { "$ref": "#/$defs/HttpForwardBackend" } }, "required": ["mcpProxy"], "additionalProperties": false }
          ]
        }
      },
      "required": ["name", "handlesPrefix", "kind"],
      "additionalProperties": false
    },
    "DoBackend": {
      "type": "object",
      "properties": {
        "binding": { "type": "string" },
        "keyArg": { "type": "string" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/McpTool" } }
      },
      "required": ["binding", "keyArg", "tools"],
      "additionalProperties": false
    },
    "ServiceBindingBackend": {
      "type": "object",
      "properties": {
        "binding": { "type": "string" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/McpTool" } }
      },
      "required": ["binding", "tools"],
      "additionalProperties": false
    },
    "UdsForwardBackend": {
      "type": "object",
      "properties": {
        "socketPath": { "type": "string" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/McpTool" } }
      },
      "required": ["socketPath", "tools"],
      "additionalProperties": false
    },
    "LeylineNetBackend": {
      "type": "object",
      "properties": {
        "companionUrlBinding": { "type": "string" },
        "upstreamId": { "type": "string" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/McpTool" } }
      },
      "required": ["companionUrlBinding", "upstreamId", "tools"],
      "additionalProperties": false
    },
    "HttpForwardBackend": {
      "type": "object",
      "properties": {
        "urlBinding": { "type": "string" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/McpTool" } },
        "dynamicTools": { "type": "boolean" },
        "stripPrefix": { "type": "string" },
        "requiresSession": { "type": "boolean" },
        "protocolMode": { "type": "string" },
        "serviceBinding": { "type": "string" },
        "claims": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["urlBinding", "tools", "dynamicTools", "stripPrefix", "requiresSession", "protocolMode", "serviceBinding", "claims"],
      "additionalProperties": false
    },
    "McpTool": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "inputSchemaJson": { "type": "string" }
      },
      "required": ["name", "description", "inputSchemaJson"],
      "additionalProperties": false
    },
    "TenantDispatchRow": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mode": { "type": "string" },
        "matchValue": { "type": "string" },
        "binding": { "type": "string" }
      },
      "required": ["name", "mode", "matchValue", "binding"],
      "additionalProperties": false
    },
    "GatewayMetadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },

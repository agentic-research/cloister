        "urlBinding": { "type": "string" },
        "serviceBinding": { "type": "string" },
        "dynamicTools": { "type": "boolean", "default": true },
        "requiresSession": { "type": "boolean" },
        "claims": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "input", "handlesPrefix", "stripPrefix", "urlBinding", "serviceBinding", "dynamicTools", "requiresSession", "claims"],
      "additionalProperties": false
    }

        "defaultAllowedSubs": { "type": "array", "items": { "type": "string" } },
        "rateLimitPerMinute": { "type": "integer", "minimum": 0 },
        "injection": {
          "oneOf": [
            { "type": "object", "properties": { "authorizationBearer": { "type": "null" } }, "required": ["authorizationBearer"], "additionalProperties": false },
            { "type": "object", "properties": { "authorizationBasic": { "type": "null" } }, "required": ["authorizationBasic"], "additionalProperties": false },
            { "type": "object", "properties": { "headerNamed": { "$ref": "#/$defs/HeaderNamedSpec" } }, "required": ["headerNamed"], "additionalProperties": false },
            { "type": "object", "properties": { "queryParam": { "$ref": "#/$defs/QueryParamSpec" } }, "required": ["queryParam"], "additionalProperties": false },
            { "type": "object", "properties": { "bodyField": { "$ref": "#/$defs/BodyFieldSpec" } }, "required": ["bodyField"], "additionalProperties": false }
          ]
        }
      },
      "required": ["name", "upstreamBaseUrl", "defaultAllowedSubs", "rateLimitPerMinute", "injection"],
      "additionalProperties": false
    },
    "HarnessTarget": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },

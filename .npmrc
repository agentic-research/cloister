# Pin pnpm's package-import-method to `hardlink`. Without this, the default
# `auto` setting can silently fall back to copy mode even when the filesystem
# supports hardlinks — verified empirically on macOS APFS 15.x with pnpm
# 10.30.3, where every package was copy-installed across worktrees (5GB+ of
# duplication for what should have been ~400MB of unique store content).
#
# Hardlink mode shares inodes between the pnpm global store and every
# `node_modules/.pnpm/` directory, so the on-disk footprint per worktree
# drops to roughly the size of the store entries themselves (the worktree's
# files share inodes with the store).
#
# Trade-off: hardlinking requires the store and consuming directory to be
# on the same filesystem. If a contributor's setup splits the pnpm store
# across volumes (uncommon), they can override locally:
#     pnpm config set package-import-method copy   # user-scoped override
# But the default-for-the-repo is hardlink because that's what every CI
# runner + every typical dev setup actually wants.
package-import-method=hardlink

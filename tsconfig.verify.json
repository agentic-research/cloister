{
  // Standalone tsconfig for the substrate-equivalence verify script
  // (Phase 2D-codec.E, cloister-5183bc). Compiles src/wire/*.ts to
  // dist-verify/wire/*.js so the verify script (which uses Node's
  // shell-out to capnp CLI) can import the codec without needing
  // node-strip-types' .ts↔.js resolution gymnastics.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist-verify",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "src/wire/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-verify",
    // signet-verify.ts + cas-hash.ts are the wasm-loading wrappers, not
    // part of the wire codec. They import a `.wasm` file by path, which
    // NodeNext resolution refuses to load (Bundler resolution in
    // tsconfig.json is fine because esbuild handles it). The substrate-
    // equivalence smoke at `scripts/smoke-leyline-stub.mjs` exercises
    // the codec round-trip, not the cert-chain verifier or BLAKE3 hasher
    // — exclude these files from the verify compile.
    // cas-hash.ts excluded per cloister-db0740 (followup to cloister-713b4e).
    "src/wire/signet-verify.ts",
    "src/wire/cas-hash.ts",
    // confinement-digest.ts imports cas-hash (BLAKE3 via wasm) for the §7
    // confinementDigest; same reason — it's not part of the wire codec the
    // substrate-equivalence smoke exercises. Excluded per cloister-c80953.
    "src/wire/confinement-digest.ts",
    // partition.ts imports cloister_cas.wasm directly (the partition-fold
    // FFI export), same NodeNext-vs-Bundler resolution mismatch as
    // cas-hash.ts above. Not part of the wire codec the substrate-
    // equivalence smoke exercises. Excluded per cloister-bc5640.
    "src/wire/partition.ts"
  ]
}

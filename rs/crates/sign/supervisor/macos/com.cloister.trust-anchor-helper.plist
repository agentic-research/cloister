<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template for leyline-sign-helper (ADR-0019, cloister-99165e).

  Install:
    cp com.cloister.trust-anchor-helper.plist ~/Library/LaunchAgents/
    # Edit the ProgramArguments path below to point at the binary
    # (e.g. /opt/homebrew/bin/leyline-sign-helper or $HOME/.cargo/bin/...).
    # Populate the env-vars block below (REQUIRED — see "Auth setup").
    launchctl load ~/Library/LaunchAgents/com.cloister.trust-anchor-helper.plist

  Verify:
    curl -fsS -H "Authorization: Bearer $TOKEN_FROM_TOKENS_BELOW" \
         http://127.0.0.1:8786/healthz

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.cloister.trust-anchor-helper.plist
    rm ~/Library/LaunchAgents/com.cloister.trust-anchor-helper.plist

  ADR-0019 ops §1: Restart=on-failure with bounded backoff.

  ADR-0019 normative req. 2: bind is HARDCODED 127.0.0.1:8786. Do not
  override — workerd's binding wouldn't find a different port.

  =================================================================
  AUTH SETUP (REQUIRED — threat-model §15.2 / cloister-7afedc + NEW-1)
  =================================================================

  The helper is launched with --require-auth below. It will REFUSE to
  start unless LEYLINE_SIGN_CALLER_TOKENS is populated below.

  Generate tokens:
    head -c32 /dev/urandom | base64 -w0  # one per authorized caller

  Then replace the placeholder values in EnvironmentVariables below.
  Each entry maps a caller-name to a token; the caller-name shows up
  in the rate-limit bucket (per-caller fairness) and structured logs.

  KEEP THIS FILE 0600. The plist contains raw tokens. After editing:
    chmod 0600 ~/Library/LaunchAgents/com.cloister.trust-anchor-helper.plist

  /resolve allow-list — REQUIRED if your deployment uses /resolve for
  vault KEK resolution. Format: comma-separated URL prefixes. NEVER
  include a prefix that could match signing-key URLs.
  Threat-model §15.1 / cloister-7aaab1 + NEW-2 (allow-list string-match
  risk): partition your keystore namespace so vault-KEK and master_sk
  cannot share a string prefix.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.cloister.trust-anchor-helper</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/leyline-sign-helper</string>
      <string>--bind</string>
      <string>127.0.0.1:8786</string>
      <string>--foreground</string>
      <!-- Threat-model §15.2 close: fail-stop on missing auth. -->
      <string>--require-auth</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <!--
        REQUIRED. Format: caller1=token1,caller2=token2[,...]
        EDIT BEFORE LAUNCH. Replace the placeholders with real tokens.
        If left as-is, the helper will fail to start with
        "auth_required_but_unset" in the log.
      -->
      <key>LEYLINE_SIGN_CALLER_TOKENS</key>
      <string>router=REPLACE_WITH_REAL_TOKEN,notme-bundle=REPLACE_WITH_REAL_TOKEN</string>

      <!--
        OPTIONAL. Comma-separated URL prefixes /resolve will hand bytes
        back for. Empty / unset = deny-all. Set this ONLY if your
        deployment uses /resolve for vault KEK resolution AND your
        keystore namespace partitions vault-KEK from signing keys.
        Example: keychain://com.cloister/vault-kek-
      -->
      <key>LEYLINE_SIGN_RESOLVE_ALLOW</key>
      <string></string>
    </dict>

    <!-- Restart on crash with bounded backoff. -->
    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
      <key>Crashed</key>
      <true/>
    </dict>

    <!-- Don't restart more than once every 10s on rapid crashes. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- stderr → log file (helper writes structured tracing here). -->
    <key>StandardErrorPath</key>
    <string>/tmp/leyline-sign-helper.log</string>

    <!-- Stay in user's keychain ACL — do NOT run as root. -->
    <key>SessionCreate</key>
    <true/>
  </dict>
</plist>

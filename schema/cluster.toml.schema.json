          "$ref": "#/$defs/TenancySpec"
        },
        "requiresSessionRetired": {
          "type": "boolean"
        },
        "connection": {
          "$ref": "#/$defs/Connection"
        },
        "mutableTagReason": {
          "type": "string"
        }
      }

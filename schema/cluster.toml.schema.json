        },
        "algorithm": {
          "type": "string"
        },
        "pubkeyBinding": {
          "type": "string"
        },
        "attestationRepo": {
          "type": "string"
        },
        "tunnelEndpoint": {
          "type": "string"
        }
      }
    },
    "InterlacePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxCertLifetimeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "requireInterlock": {
          "type": "boolean"
        },
        "minAlgorithm": {
          "type": "string"
        }
      }

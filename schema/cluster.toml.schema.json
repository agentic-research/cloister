{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agentic-research/cloister/main/schema/cluster.toml.schema.json",
  "title": "cloister cluster.toml",
  "description": "The operator's declaration of a cloister cluster. Generated from manifest/cluster.capnp by LLO's schema-bridge and scripts/gen-cluster-toml-schema.mjs; do not edit by hand. A file that validates here has the right shape. The build still checks what a schema cannot: names that must match, ports that must exist, strengths that must be met.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "#/$defs/ClusterMetadata"
    },
    "bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Bundle"
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Wire"
      }
    },
    "storage": {
      "$ref": "#/$defs/StoragePolicy"
    },
    "inputs": {
      "oneOf": [
        {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/InputSpecByName"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputSpec"
          }
        }
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Route"
      }
    },
    "gateway": {
      "$ref": "#/$defs/Gateway"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EdgeSpec"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConnectionSpec"
      }
    }
  },
  "required": [
    "metadata"
  ],
  "$defs": {
    "Tier": {
      "type": "string",
      "enum": [
        "hypervisor",
        "cluster"
      ]
    },
    "ClusterMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "holdsCredential": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workerdServiceName": {
          "type": "string"
        },
        "hypervisorRationale": {
          "type": "string"
        },
        "perTenant": {
          "type": "boolean"
        },
        "confinement": {
          "$ref": "#/$defs/Confinement"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortSpec"
          }
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlacementSpec"
          }
        },
        "workerd": {
          "$ref": "#/$defs/WorkerdBundle"
        },
        "external": {
          "$ref": "#/$defs/ExternalBundle"
        },
        "kind": {
          "type": "string",
          "enum": [
            "workerd",
            "external"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "workerd"
            },
            "external": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "external"
            },
            "workerd": false
          }
        }
      ]
    },
    "Wire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "binding": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": [
            "uds",
            "leylineNet"
          ]
        }
      }
    },
    "StoragePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doStoragePath": {
          "type": "string"
        }
      }
    },
    "InputSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "urlBinding": {
          "type": "string"
        },
        "serviceBinding": {
          "type": "string"
        },
        "tenancy": {
          "$ref": "#/$defs/TenancySpec"
        },
        "requiresSessionRetired": {
          "type": "boolean"
        },
        "connection": {
          "$ref": "#/$defs/Connection"
        },
        "mutableTagReason": {
          "type": "string"
        }
      }
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "mcp": {
          "$ref": "#/$defs/McpRouteSpec"
        },
        "serviceBindingProxy": {
          "$ref": "#/$defs/ServiceBindingProxySpec"
        },
        "httpProxy": {
          "$ref": "#/$defs/HttpProxySpec"
        },
        "vaultProxy": {
          "$ref": "#/$defs/VaultProxySpec"
        },
        "tenantDispatch": {
          "$ref": "#/$defs/TenantDispatchSpec"
        },
        "kind": {
          "type": "string",
          "enum": [
            "health",
            "mcp",
            "serviceBindingProxy",
            "httpProxy",
            "wellKnownInterlace",
            "disclosure",
            "wellKnownIdentityBridge",
            "ociRegistry",
            "wellKnownMcpRegistry",
            "caBundle",
            "vaultProxy",
            "tenantDispatch"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "health"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "httpProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "mcp"
            },
            "serviceBindingProxy": false,
            "httpProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "serviceBindingProxy"
            },
            "mcp": false,
            "httpProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "httpProxy"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "wellKnownInterlace"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "httpProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "disclosure"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "httpProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "wellKnownIdentityBridge"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "httpProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "ociRegistry"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "httpProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "wellKnownMcpRegistry"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "httpProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "caBundle"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "httpProxy": false,
            "vaultProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "vaultProxy"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "httpProxy": false,
            "tenantDispatch": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "tenantDispatch"
            },
            "mcp": false,
            "serviceBindingProxy": false,
            "httpProxy": false,
            "vaultProxy": false
          }
        }
      ]
    },
    "Gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/GatewayMetadata"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "policy": {
          "$ref": "#/$defs/InterlacePolicy"
        },
        "vaultProxyServices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VaultProxyService"
          }
        },
        "harnessTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HarnessTarget"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillDeclaration"
          }
        }
      }
    },
    "EdgeSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "appProtocol": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        }
      }
    },
    "ConnectionSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "appProtocol": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectionTarget"
          }
        },
        "minStrength": {
          "type": "string"
        }
      }
    },
    "WorkerdBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entryPoint": {
          "type": "string"
        }
      }
    },
    "ExternalBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "ipcSocket": {
          "type": "string"
        },
        "httpPort": {
          "type": "integer",
          "minimum": 0
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvVar"
          }
        },
        "entryPoint": {
          "type": "string"
        },
        "executionMode": {
          "type": "string"
        },
        "executionModeRationale": {
          "type": "string"
        }
      }
    },
    "Confinement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fs": {
          "$ref": "#/$defs/ConfinementFs"
        },
        "network": {
          "$ref": "#/$defs/ConfinementNetwork"
        },
        "port": {
          "$ref": "#/$defs/ConfinementPort"
        },
        "credentialSource": {
          "type": "string"
        }
      }
    },
    "PortSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0
        },
        "appProtocol": {
          "type": "string"
        },
        "expose": {
          "type": "string"
        }
      }
    },
    "PlacementSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        }
      }
    },
    "ConfinementFs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/FsAllowEntry"
              }
            ]
          }
        }
      }
    },
    "ConfinementNetwork": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ConfinementPort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bind": {
          "type": "integer",
          "minimum": 0
        },
        "address": {
          "type": "string"
        }
      }
    },
    "FsAllowEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      }
    },
    "EnvVar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "TenancySpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "workerdId": {
          "type": "string"
        },
        "trustedTier": {
          "type": "boolean"
        },
        "sharesWorkerdWith": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "socketPath": {
          "type": "string"
        },
        "vaultSlice": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": [
            "unset",
            "uds"
          ]
        }
      }
    },
    "McpRouteSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Backend"
          }
        }
      }
    },
    "ServiceBindingProxySpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "type": "string"
        },
        "upstreamHost": {
          "type": "string"
        },
        "stripPrefix": {
          "type": "string"
        }
      }
    },
    "HttpProxySpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urlBinding": {
          "type": "string"
        },
        "stripPrefix": {
          "type": "string"
        }
      }
    },
    "VaultProxySpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundleIdName": {
          "type": "string"
        }
      }
    },
    "TenantDispatchSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TenantDispatchRow"
          }
        }
      }
    },
    "Backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "handlesPrefix": {
          "type": "string"
        },
        "durableObject": {
          "$ref": "#/$defs/DoBackend"
        },
        "serviceBinding": {
          "$ref": "#/$defs/ServiceBindingBackend"
        },
        "udsForward": {
          "$ref": "#/$defs/UdsForwardBackend"
        },
        "leylineNet": {
          "$ref": "#/$defs/LeylineNetBackend"
        },
        "mcpProxy": {
          "$ref": "#/$defs/HttpForwardBackend"
        },
        "kind": {
          "type": "string",
          "enum": [
            "durableObject",
            "serviceBinding",
            "udsForward",
            "leylineNet",
            "mcpProxy"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "durableObject"
            },
            "serviceBinding": false,
            "udsForward": false,
            "leylineNet": false,
            "mcpProxy": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "serviceBinding"
            },
            "durableObject": false,
            "udsForward": false,
            "leylineNet": false,
            "mcpProxy": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "udsForward"
            },
            "durableObject": false,
            "serviceBinding": false,
            "leylineNet": false,
            "mcpProxy": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "leylineNet"
            },
            "durableObject": false,
            "serviceBinding": false,
            "udsForward": false,
            "mcpProxy": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "mcpProxy"
            },
            "durableObject": false,
            "serviceBinding": false,
            "udsForward": false,
            "leylineNet": false
          }
        }
      ]
    },
    "DoBackend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "type": "string"
        },
        "keyArg": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/McpTool"
          }
        }
      }
    },
    "ServiceBindingBackend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/McpTool"
          }
        }
      }
    },
    "UdsForwardBackend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "socketPath": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/McpTool"

          "type": "string"
        },
        "upstreamId": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/McpTool"
          }
        }
      }
    },
    "HttpForwardBackend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urlBinding": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/McpTool"
          }
        },
        "dynamicTools": {
          "type": "boolean"
        },
        "stripPrefix": {
          "type": "string"
        },
        "requiresSession": {
          "type": "boolean"
        },
        "protocolMode": {
          "type": "string"
        },
        "serviceBinding": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "McpTool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "inputSchemaJson": {
          "type": "string"
        }
      }
    },
    "TenantDispatchRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "matchValue": {
          "type": "string"
        },
        "binding": {
          "type": "string"
        }
      }
    },
    "GatewayMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "metaNamespace": {
          "type": "string"
        }
      }
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fingerprint": {

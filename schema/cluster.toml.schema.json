      "type": "object",
      "description": "An external tool, skill or bundle the cluster composes.",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "Where the input comes from: a registry name, an https URL, or a file URL."
        },
        "version": {
          "type": "string",
          "description": "The version, or a semver range. Empty picks the latest, which is not recommended."
        },
        "digest": {
          "type": "string",
          "description": "The expected digest, as 'sha256:<hex>'. The fetched bytes must match it. Empty means the resolver pins one in cluster.lock.toml."
        },
        "from": {
          "type": "string",
          "description": "A local checkout to use while developing, as a file URL. It overrides ref, so it must not be committed."
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Capabilities this input offers, for example 'cloister/mcp-tool/v1'."
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Capabilities this input needs another input to provide."
        },
        "urlBinding": {
          "type": "string",
          "description": "The binding that holds the input's upstream URL."
        },
        "serviceBinding": {
          "type": "string",
          "description": "The workerd service binding that reaches the input, used in preference to urlBinding when set."
        },

node_modules/
.wrangler/
dist/

# Per-user dev secrets — generated by `task dev:bootstrap` per ADR-0014 v2.
# Contains DEV_VAULT_KEK (32-byte hex). NEVER COMMIT.
.env.local

# CRUMB - personal memory (not tracked)
.crumb/

# generated typed TS modules — TRACKED in git (per cloister-0854b7).
# These are deterministic codegen outputs:
#   manifest.ts      from cloister.capnp via scripts/build-manifest.mjs
#   tool-schemas.ts  from src/tool-schemas/*.ts via scripts/build-tool-schemas.mjs
#   cluster.ts       from cluster.capnp via scripts/build-cluster.mjs
# Tracking them lets cloister's OCI build (melange) skip the build-time
# capnp dependency entirely (capnproto isn't in Wolfi). Drift between
# source + generated is gated by .github/workflows/generated-drift.yml
# — same pattern as clients/go/cloister-schema-go.yml does for the
# Go bindings.
# src/generated/   # <-- intentionally NOT ignored

# generated by `task wire:verify-roundtrip` (tsc precompile of src/wire/)
dist-verify/

# go-task's local fingerprint cache (tracks `sources:` mtimes/checksums
# so up-to-date detection works without re-running steps unnecessarily)
.task/

# Claude Code session state — cron locks, scheduled-task store, etc.
.claude/

# melange/apko build artifacts (local-only — keys must not be committed)
melange.rsa
melange.rsa.pub
packages/
cloister*.tar
sbom-*.spdx.json

# rsry per-repo dolt store — runtime state only. The dolt/ subdirectory
# and metadata.json track in git (beads are first-class repo data,
# managed via the rsry MCP). PID/port files regenerate on every
# `rsry enable` / dolt server start.
.beads/dolt-server.pid
.beads/dolt-server.port

# Agent transcripts — full JSONL of subagent runs (bucketing audits,
# theoretical-foundations reviews, etc.). May contain prompts, paths,
# and reasoning traces specific to one developer's machine. Local
# debugging artifact; not source. Preventive ignore so accidentally
# `git add` doesn't ship them.
_agent_log/

# Rust build artifacts (rs/crates/sign + future rs/ workspace members).
# rs/Cargo.lock is intentionally tracked — cloister's a deployable thing,
# we want reproducible builds. Only the build output dir is ignored.
rs/target/

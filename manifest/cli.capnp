# cli.capnp — the cloister command line, declared (ADR-0077).
#
# Each JSON output a command prints is a struct here, and every projection of
# it is generated by LLO's schema-bridge: src/generated/cli.zod.ts, which
# every test that produces such an output parses it with, strictly; and the
# published schema/cli.schema.json, which a consumer validates against
# (gen/cli-schema.mjs).
#
# Every output carries `formatVersion`, "MAJOR.MINOR", after Terraform's
# `format_version`: a minor change only adds; anything else is a major
# change. schema/cli-formats.lock.json pins each version to the digest of its
# generated schema, so the shape cannot change without the version changing.
#
# `$Traits.doc` is the only description that reaches generated files; `#`
# comments are for readers of this file. Schema-evolution rules as for every
# capnp file here: append-only fields, ordinals never renumbered (ADR-0004).
@0xcccfe1dcf686bda6;

using Traits = import "_traits.capnp";

# ── Shared ───────────────────────────────────────────────────────────────────

enum Strength $Traits.doc("What stops a bundle that is not the declared caller from reaching the target (ADR-0070 §3).") {
  none       @0 $Traits.doc("Nothing enforces it.");
  policy     @1 $Traits.doc("A reachable peer is refused.");
  capability @2 $Traits.doc("The workload holds nothing to dial.");
}

# ── cloister cluster graph --json (ADR-0075) ────────────────────────────────

enum EdgeDeclaration $Traits.doc("How cluster.toml declares the edge.") {
  connection @0 $Traits.doc("A [[connections]] row.");
  wire       @1 $Traits.doc("A [[wires]] row.");
}

struct GraphEdge $Traits.doc("One edge: what carries it where it runs, and what holds it.") {
  from         @0 :Text            $Traits.doc("The calling bundle.");
  to           @1 :Text            $Traits.doc("The bundle called.");
  declaredAs   @2 :EdgeDeclaration $Traits.doc("How cluster.toml declares it.");
  name         @3 :Text            $Traits.doc("The connection's name, or the wire's binding.");
  carrier      @4 :Text            $Traits.doc("What carries it where it runs, in a phrase.");
  strength     @5 :Strength        $Traits.doc("What the emitter for its placement writes today, never what is intended.");
  minStrength  @6 :Strength        $Traits.doc("The minimum cluster.toml asks for; none when it asks for no minimum.");
  meetsMinimum @7 :Bool            $Traits.doc("False when strength is below minStrength.");
  why          @8 :Text            $Traits.doc("The mechanism, or the absence of one, in a sentence.");
}

struct GraphElsewhere $Traits.doc("A connection with no target in this environment.") {
  from @0 :Text       $Traits.doc("The calling bundle.");
  name @1 :Text       $Traits.doc("The connection's name.");
  envs @2 :List(Text) $Traits.doc("The environments it has a target in.");
}

struct StrengthCounts $Traits.doc("How many edges have each strength.") {
  none       @0 :UInt32;
  policy     @1 :UInt32;
  capability @2 :UInt32;
}

struct Graph $Traits.doc("The output of `cloister cluster graph --json`.") {
  formatVersion @0 :Text                 $Traits.doc("\"MAJOR.MINOR\". Refuse a major you do not know; ignore fields you do not know.");
  env           @1 :Text                 $Traits.doc("The environment the graph is for.");
  edges         @2 :List(GraphEdge)      $Traits.doc("Every connection with a target in env, and every wire.");
  elsewhere     @3 :List(GraphElsewhere) $Traits.doc("Connections with no target in env, listed rather than dropped.");
  counts        @4 :StrengthCounts       $Traits.doc("Edges by strength.");
}

{
  "provider": "hashicorp/kubernetes",
  "objects": {
    "kubernetes_manifest": {
      "attr": "manifest",
      "by": [
        "apiVersion",
        "kind"
      ]
    }
  },
  "types": {
    "kubernetes_deployment_v1": {
      "name": "metadata.name",
      "read": [
        "metadata.namespace"
      ],
      "referenceAttrs": [
        "spec"
      ],
      "maps": [
        "spec.template.metadata.labels"
      ],
      "lists": [
        {
          "path": "spec.template.spec.container",
          "read": [
            "name",
            "image"
          ],
          "strings": [
            "args",
            "command"
          ]
        },
        {
          "path": "spec.template.spec.container.env",
          "read": [
            "name",
            "value"
          ]
        },
        {
          "path": "spec.template.spec.container.port",
          "read": [
            "name",
            "container_port"
          ]
        }
      ],
      "configLists": [
        {
          "path": "spec.template.spec.container.env",
          "fields": [
            "name",
            "value",
            "value_from.secret_key_ref.name",
            "value_from.secret_key_ref.key"
          ]
        }
      ],
      "report": {
        "section": "Kubernetes deployments",
        "show": [
          "metadata.namespace"
        ],
        "dials": [
          {
            "list": "env",
            "value": "value",
            "label": "name",
            "prefix": "env"
          },
          {
            "list": "container",
            "strings": "args",
            "prefix": "args"
          },
          {
            "list": "container",
            "strings": "command",
            "prefix": "command"
          }
        ],
        "references": [
          "spec"
        ],
        "bundle": {
          "placement": "kubernetes",
          "runs": "service",
          "container": {
            "list": "container"
          },
          "image": {
            "list": "container",
            "value": "image"
          },
          "args": {
            "list": "container",
            "strings": "args"
          },
          "command": {
            "list": "container",
            "strings": "command"
          },
          "env": {
            "configured": "env",
            "name": "name",
            "value": "value",
            "secret": "value_from.secret_key_ref.name",
            "secretVersion": "value_from.secret_key_ref.key"
          },
          "ports": {
            "list": "port",
            "name": "name",
            "port": "container_port",
            "byConvention": true
          },
          "wires": {
            "http": "art.http",
            "http1": "art.http",
            "h2c": "art.http2",
            "grpc": "art.grpc"
          }
        }
      }
    },
    "kubernetes_deployment": {
      "like": "kubernetes_deployment_v1"
    },
    "kubernetes_stateful_set_v1": {
      "like": "kubernetes_deployment_v1",
      "report": {
        "section": "Kubernetes stateful sets"
      }
    },
    "kubernetes_stateful_set": {
      "like": "kubernetes_deployment_v1",
      "report": {
        "section": "Kubernetes stateful sets"
      }
    },
    "kubernetes_daemon_set_v1": {
      "like": "kubernetes_deployment_v1",
      "report": {
        "section": "Kubernetes daemon sets"
      }
    },
    "kubernetes_daemonset": {
      "like": "kubernetes_deployment_v1",
      "report": {
        "section": "Kubernetes daemon sets"
      }
    },
    "kubernetes_job_v1": {
      "like": "kubernetes_deployment_v1",
      "report": {
        "section": "Kubernetes jobs",
        "bundle": {
          "runs": "job"
        }
      }
    },
    "kubernetes_job": {
      "like": "kubernetes_deployment_v1",
      "report": {
        "section": "Kubernetes jobs",
        "bundle": {
          "runs": "job"
        }
      }
    },
    "kubernetes_service_v1": {
      "name": "metadata.name",
      "read": [
        "metadata.namespace",
        "spec.type"
      ],
      "maps": [
        "spec.selector"
      ],
      "report": {
        "section": "Kubernetes services",
        "show": [
          "metadata.namespace",
          "spec.type"
        ],
        "hosts": [
          "{name}.{metadata.namespace}.svc.cluster.local",
          "{name}.{metadata.namespace}.svc"
        ],
        "standsFor": {
          "selector": "spec.selector",
          "labels": "spec.template.metadata.labels",
          "toTypes": [
            "kubernetes_deployment_v1",
            "kubernetes_deployment",
            "kubernetes_stateful_set_v1",
            "kubernetes_stateful_set",
            "kubernetes_daemon_set_v1",
            "kubernetes_daemonset",
            "kubernetes_manifest apps/v1 Deployment",
            "kubernetes_manifest apps/v1 StatefulSet",
            "kubernetes_manifest apps/v1 DaemonSet"
          ],
          "scope": [
            "metadata.namespace"
          ]
        }
      }
    },
    "kubernetes_service": {
      "like": "kubernetes_service_v1"
    },
    "kubernetes_namespace_v1": {
      "name": "metadata.name",
      "report": {
        "section": "Kubernetes namespaces",
        "show": []
      }
    },
    "kubernetes_namespace": {
      "like": "kubernetes_namespace_v1"
    },
    "kubernetes_manifest apps/v1 Deployment": {
      "name": "metadata.name",
      "read": [
        "metadata.namespace"
      ],
      "maps": [
        "spec.template.metadata.labels"
      ],
      "lists": [
        {
          "path": "spec.template.spec.containers",
          "read": [
            "name",
            "image"
          ],
          "strings": [
            "args",
            "command"
          ]
        },
        {
          "path": "spec.template.spec.containers.env",
          "read": [
            "name",
            "value",
            "valueFrom.secretKeyRef.name",
            "valueFrom.secretKeyRef.key"
          ]
        },
        {
          "path": "spec.template.spec.containers.ports",
          "read": [
            "name",
            "containerPort"
          ]
        }
      ],
      "report": {
        "section": "Kubernetes deployments",
        "show": [
          "metadata.namespace"
        ],
        "dials": [
          {
            "list": "env",
            "value": "value",
            "label": "name",
            "prefix": "env"
          },
          {
            "list": "containers",
            "strings": "args",
            "prefix": "args"
          },
          {
            "list": "containers",
            "strings": "command",
            "prefix": "command"
          }
        ],
        "bundle": {
          "placement": "kubernetes",
          "runs": "service",
          "container": {
            "list": "containers"
          },
          "image": {
            "list": "containers",
            "value": "image"
          },
          "args": {
            "list": "containers",
            "strings": "args"
          },
          "command": {
            "list": "containers",
            "strings": "command"
          },
          "env": {
            "list": "env",
            "name": "name",
            "value": "value",
            "secret": "valueFrom.secretKeyRef.name",
            "secretVersion": "valueFrom.secretKeyRef.key"
          },
          "ports": {
            "list": "ports",
            "name": "name",
            "port": "containerPort",
            "byConvention": true
          },
          "wires": {
            "http": "art.http",
            "http1": "art.http",
            "h2c": "art.http2",
            "grpc": "art.grpc"
          }
        }
      }
    },
    "kubernetes_manifest apps/v1 StatefulSet": {
      "like": "kubernetes_manifest apps/v1 Deployment",
      "report": {
        "section": "Kubernetes stateful sets"
      }
    },
    "kubernetes_manifest apps/v1 DaemonSet": {
      "like": "kubernetes_manifest apps/v1 Deployment",
      "report": {
        "section": "Kubernetes daemon sets"
      }
    },
    "kubernetes_manifest batch/v1 Job": {
      "like": "kubernetes_manifest apps/v1 Deployment",
      "report": {
        "section": "Kubernetes jobs",
        "bundle": {
          "runs": "job"
        }
      }
    },
    "kubernetes_manifest v1 Service": {
      "like": "kubernetes_service_v1"
    },
    "kubernetes_manifest v1 Namespace": {
      "like": "kubernetes_namespace_v1"
    },
    "kubernetes_manifest serving.knative.dev/v1 Service": {
      "name": "metadata.name",
      "read": [
        "metadata.namespace"
      ],
      "maps": [
        "metadata.labels"
      ],
      "lists": [
        {
          "path": "spec.template.spec.containers",
          "read": [
            "name",
            "image"
          ],
          "strings": [
            "args",
            "command"
          ]
        },
        {
          "path": "spec.template.spec.containers.env",
          "read": [
            "name",
            "value",
            "valueFrom.secretKeyRef.name",
            "valueFrom.secretKeyRef.key"
          ]
        },
        {
          "path": "spec.template.spec.containers.ports",
          "read": [
            "name",
            "containerPort"
          ]
        }
      ],
      "report": {
        "section": "Knative services",
        "show": [
          "metadata.namespace"
        ],
        "hosts": [
          "{name}.{metadata.namespace}.svc.cluster.local",
          "{name}.{metadata.namespace}.svc"
        ],
        "dials": [
          {
            "list": "env",
            "value": "value",
            "label": "name",
            "prefix": "env"
          },
          {
            "list": "containers",
            "strings": "args",
            "prefix": "args"
          },
          {
            "list": "containers",
            "strings": "command",
            "prefix": "command"
          }
        ],
        "bundle": {
          "placement": "knative",
          "runs": "service",
          "container": {
            "list": "containers",
            "serving": "ports"
          },
          "image": {
            "list": "containers",
            "value": "image"
          },
          "args": {
            "list": "containers",
            "strings": "args"
          },
          "command": {
            "list": "containers",
            "strings": "command"
          },
          "env": {
            "list": "env",
            "name": "name",
            "value": "value",
            "secret": "valueFrom.secretKeyRef.name",
            "secretVersion": "valueFrom.secretKeyRef.key"
          },
          "ports": {
            "list": "ports",
            "name": "name",
            "port": "containerPort",
            "default": {
              "name": "http1",
              "port": 8080
            }
          },
          "wires": {
            "http1": "art.http",
            "h2c": "art.http2"
          },
          "exposure": {
            "attr": "metadata.labels",
            "key": "networking.knative.dev/visibility",
            "cluster": [
              "cluster-local"
            ],
            "edge": []
          }
        }
      }
    }
  }
}

{
  "provider": "hashicorp/google",
  "types": {
    "google_cloud_run_v2_service": {
      "name": "name",
      "read": ["location", "ingress"],
      "ids": ["project"]
    },
    "google_cloud_run_service_iam_member": {
      "read": ["role", "member", "service"],
      "ids": ["project"],
      "referenceAttrs": ["service"],
      "relations": [{ "attr": "service", "toType": "google_cloud_run_v2_service", "toAttr": "name" }]
    },
    "google_cloud_run_v2_service_iam_member": {
      "read": ["role", "member", "name"],
      "ids": ["project"],
      "referenceAttrs": ["name"],
      "relations": [{ "attr": "name", "toType": "google_cloud_run_v2_service", "toAttr": "name" }]
    },
    "google_sql_database_instance": {
      "name": "name",
      "read": ["database_version", "region"],
      "ids": ["project"]
    },
    "google_cloud_tasks_queue": {
      "name": "name",
      "read": ["location"],
      "ids": ["project"]
    }
  }
}

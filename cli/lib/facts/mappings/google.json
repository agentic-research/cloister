{
  "provider": "hashicorp/google",
  "types": {
    "google_cloud_run_v2_service": {
      "name": "name",
      "read": ["location", "ingress", "uri"],
      "ids": ["project", "id"],
      "referenceAttrs": ["template"],
      "lists": [
        { "path": "template.containers", "read": ["name", "image"], "strings": ["args", "command"] },
        { "path": "template.containers.env", "read": ["name", "value"] },
        { "path": "template.containers.ports", "read": ["name", "container_port"] }
      ],
      "report": {
        "section": "Cloud Run services", "show": ["location", "ingress"],
        "address": "uri",
        "dials": [
          { "list": "env", "value": "value", "label": "name", "prefix": "env" },
          { "list": "containers", "strings": "args", "prefix": "args" },
          { "list": "containers", "strings": "command", "prefix": "command" }
        ],
        "references": ["template"],
        "bundle": {
          "placement": "cloudRun",
          "image": { "list": "containers", "value": "image" },
          "ports": { "list": "ports", "name": "name", "port": "container_port", "default": { "name": "http1", "port": 8080 } },
          "wires": { "http1": "art.http", "h2c": "art.http2" }
        }
      }
    },
    "google_cloud_run_service_iam_member": {
      "read": ["role", "member", "service", "location"],
      "ids": ["project"],
      "referenceAttrs": ["service"],
      "relations": [{
        "attr": "service", "toType": "google_cloud_run_v2_service", "toAttr": ["id", "name"],
        "scope": ["project", "location"], "stripPrefix": "v1/"
      }],
      "access": {
        "role": "role", "principal": "member",
        "roles": { "roles/run.invoker": "invoker" },
        "publicPrincipals": ["allUsers", "allAuthenticatedUsers"]
      }
    },
    "google_cloud_run_v2_service_iam_member": {
      "read": ["role", "member", "name", "location"],
      "ids": ["project"],
      "referenceAttrs": ["name"],
      "relations": [{
        "attr": "name", "toType": "google_cloud_run_v2_service", "toAttr": ["id", "name"],
        "scope": ["project", "location"]
      }],
      "access": {
        "role": "role", "principal": "member",
        "roles": { "roles/run.invoker": "invoker" },
        "publicPrincipals": ["allUsers", "allAuthenticatedUsers"]
      }
    },
    "google_cloud_run_v2_job": {
      "name": "name",
      "read": ["location"],
      "ids": ["project", "id"],
      "referenceAttrs": ["template"],
      "lists": [
        { "path": "template.template.containers", "read": ["name", "image"], "strings": ["args", "command"] },
        { "path": "template.template.containers.env", "read": ["name", "value"] },
        { "path": "template.template.containers.ports", "read": ["name", "container_port"] }
      ],
      "report": {
        "section": "Cloud Run jobs", "show": ["location"],
        "dials": [
          { "list": "env", "value": "value", "label": "name", "prefix": "env" },
          { "list": "containers", "strings": "args", "prefix": "args" },
          { "list": "containers", "strings": "command", "prefix": "command" }
        ],
        "references": ["template"],
        "bundle": {
          "placement": "cloudRun",
          "image": { "list": "containers", "value": "image" }
        }
      }
    },
    "google_cloud_run_v2_job_iam_member": {
      "read": ["role", "member", "name", "location"],
      "ids": ["project"],
      "referenceAttrs": ["name"],
      "relations": [{
        "attr": "name", "toType": "google_cloud_run_v2_job", "toAttr": ["id", "name"],
        "scope": ["project", "location"]
      }],
      "access": {
        "role": "role", "principal": "member",
        "roles": { "roles/run.invoker": "invoker" },
        "publicPrincipals": ["allUsers", "allAuthenticatedUsers"]
      }
    },
    "google_sql_database_instance": {
      "name": "name",
      "read": ["database_version", "region"],
      "ids": ["project"],
      "report": { "section": "Databases", "show": ["database_version", "region"] }
    },
    "google_cloud_tasks_queue": {
      "name": "name",
      "read": ["location"],
      "ids": ["project"],
      "report": { "section": "Queues", "show": ["location"] }
    }
  }
}

#!/bin/sh
# scripts/git-hooks/pre-push — runs `task pre-push` to catch CI failures before push.
#
# Installed into `.git/hooks/pre-push` by `task install-hooks`.
# Per cloister-8e40ad — preventing the "task lint green locally but
# CI red on push" trap caused by Taskfile mtime caching.
#
# To bypass once (e.g. emergency push), use: git push --no-verify
#
# The --force flag below bypasses Taskfile mtime caching, which can
# silently mask failures when sources haven't changed but the test
# logic did (the specific bug that broke CI multiple times historically).

set -e
cd "$(git rev-parse --show-toplevel)"
echo "▸ pre-push: running task pre-push (forces Taskfile cache bypass)..."
task --force pre-push

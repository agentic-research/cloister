{
  "name": "cloister",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "v8-isolate hypervisor on workerd — declarative route table, cryptographically-verifiable identity substrate (Interlace), capability-shaped credential distribution. MCP is one tenant.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentic-research/cloister.git"
  },
  "homepage": "https://github.com/agentic-research/cloister#readme",
  "bugs": {
    "url": "https://github.com/agentic-research/cloister/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "workerd",
    "cloudflare-workers",
    "mcp",
    "model-context-protocol",
    "durable-objects",
    "edge-router",
    "interlace",
    "ed25519",
    "capnp",
    "substrate"
  ],
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "cloister": "./scripts/cli-init.mjs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@cloudflare/workers-types": "^4.20250101.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.9",
    "workerd": "^1.20260511.1",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "cbor-x": "^1.6.4",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "comment": "Pin transitive undici past its Dependabot advisories (TLS-bypass + SOCKS5 highs, header-injection, etc). Scoped to the 7.x instance (wrangler@4/miniflare@4 tree); the undici@5.x instance under wrangler@3 clears when wrangler is bumped to 4. vite/esbuild are peer-provided by the vitest toolchain and move with a toolchain bump, not an override.",
    "overrides": {
      "undici@>=7.0.0 <7.28.0": "^7.28.0",
      "esbuild@>=0.27.0 <0.28.1": "^0.28.1"
    }
  }
}
